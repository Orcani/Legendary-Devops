{
  "name": "legendary-devops",
  "productName": "Legendary DevOps",
  "description": "Révision active et ludique des fondamentaux DevOps, 100 % hors ligne.",
  "author": "Legendary DevOps",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.cjs",
    "dev": "vite",
    "validate-data": "node scripts/validate-data.mjs",
    "build": "npm run validate-data && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test scripts/progression.test.js",
    "test:electron": "node scripts/run-electron-smoke.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@fontsource-variable/lexend": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "framer-motion": "^14.9.1",
    "globals": "^15.11.0",
    "lucide-react": "^1.68.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "fr.legendarydevops.app",
    "productName": "Legendary DevOps",
    "copyright": "Legendary DevOps",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/*.map"
    ],
    "extraResources": [
      {
        "from": "public/data/dataApp.json",
        "to": "data/dataApp.json"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Legendary DevOps",
      "artifactName": "Legendary-DevOps-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "dmg": {
      "artifactName": "Legendary-DevOps-${version}-${arch}.${ext}"
    }
  }
}
